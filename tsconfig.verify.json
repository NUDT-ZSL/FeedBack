{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".verify-build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/types.ts", "src/formations.ts", "src/GameSimulation.ts", "src/campaign.ts", "scripts/verify-campaign.ts"]
}
