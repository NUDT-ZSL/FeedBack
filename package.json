{
  "name": "pixel-bullet-hell",
  "version": "1.0.0",
  "description": "像素风弹幕射击生存挑战游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulate": "tsc -p tsconfig.sim.json && node dist-sim/sim/cli.js",
    "simulate:check": "tsc -p tsconfig.sim.json && node dist-sim/sim/cli.js --check"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
