      "expect": {
        "order": ["a", "b", "c", "d", "e", "f", "g", "h"],
        "est": { "a": 0, "b": 2, "c": 2, "d": 5, "e": 8, "f": 7, "g": 0, "h": 5 },
        "finish": { "a": 2, "b": 5, "c": 8, "d": 7, "e": 12, "f": 8, "g": 5, "h": 6 },
