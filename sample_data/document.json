{
  "title": "产品需求文档: 在线协作白板",
  "sections": [
    {
      "id": "s1",
      "title": "1. 项目背景",
      "paragraphs": [
        {"id": "p1", "text": "远程办公场景下, 团队缺少低延迟的图形化协作手段。"},
        {"id": "p2", "text": "现有工具在多人同时编辑时经常出现内容丢失。"}
      ],
      "children": [
        {
          "id": "s1-1",
          "title": "1.1 目标用户",
          "paragraphs": [
            {"id": "p3", "text": "主要面向 10 人以内的产品设计团队。"}
          ],
          "children": []
        }
      ]
    },
    {
      "id": "s2",
      "title": "2. 功能需求",
      "paragraphs": [
        {"id": "p4", "text": "系统应支持最多 20 人同时在线编辑同一块白板。"},
        {"id": "p5", "text": "白板内容需要每 30 秒自动保存一次。"}
      ],
      "children": [
        {
          "id": "s2-1",
          "title": "2.1 性能指标",
          "paragraphs": [
            {"id": "p6", "text": "操作同步延迟应低于 200 毫秒。"}
          ],
          "children": []
        }
      ]
    },
    {
      "id": "s3",
      "title": "3. 发布计划",
      "paragraphs": [
        {"id": "p7", "text": "第一个内测版本计划在第四季度发布。"}
      ],
      "children": []
    }
  ]
}
