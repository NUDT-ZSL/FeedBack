{
  "root": "wizard",
  "initialFocus": "name",
  "containers": [
    { "id": "wizard", "label": "注册向导" },
    { "id": "step1", "label": "第一步 · 基本信息" },
    { "id": "step2", "label": "第二步 · 账户安全" },
    { "id": "step3", "label": "第三步 · 偏好设置" },
    { "id": "actions", "label": "操作区" }
  ],
  "children": {
    "wizard": ["step1", "step2", "step3", "actions"],
    "step1": ["name", "email", "phone"],
    "step2": ["password", "confirm", "invite"],
    "step3": ["theme", "newsletter"],
    "actions": ["prev", "next", "submit"]
  },
  "elements": [
    { "id": "name", "label": "姓名", "required": true },
    { "id": "email", "label": "邮箱", "required": true },
    { "id": "phone", "label": "手机号" },
    { "id": "password", "label": "密码", "required": true },
    { "id": "confirm", "label": "确认密码", "required": true },
    { "id": "invite", "label": "邀请码" },
    { "id": "theme", "label": "主题选择" },
    { "id": "newsletter", "label": "订阅邮件" },
    { "id": "prev", "label": "上一步" },
    { "id": "next", "label": "下一步", "required": true },
    { "id": "submit", "label": "提交", "required": true }
  ],
  "constraints": [
    { "id": "j1", "from": "email", "to": "password", "priority": 10, "note": "邮箱验证后直达账户设置" },
    { "id": "j2", "from": "email", "to": "phone", "priority": 3, "note": "低优先级回退方案" },
    { "id": "k1", "from": "confirm", "to": "theme", "priority": 8, "note": "确认密码后进入偏好" },
    { "id": "k2", "from": "newsletter", "to": "password", "priority": 4, "note": "循环示例：跳回密码" }
  ]
}
